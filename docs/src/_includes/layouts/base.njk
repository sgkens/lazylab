{% macro icon(name) %}<svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#icon-{{ name }}"></use></svg>{% endmacro %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ site.title }} docs</title>
  <meta name="description" content="{{ abstract or description or site.description }}">
  <meta name="theme-color" content="#fafaf9">
  <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg">
  <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.title }} docs">
  <meta property="og:title" content="{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ site.title }}">
  <meta property="og:description" content="{{ abstract or site.description }}">
  {% if site.url %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/brand/lazylab-social.png">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="640">
  <meta name="twitter:card" content="summary_large_image">
  {% endif %}
  <link rel="stylesheet" href="/assets/docs.css">
  <script>
    try { const t = localStorage.getItem('lazylab-docs-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
  </script>
  <script type="module" src="/assets/docs.js"></script>
</head>
<body id="top">
  <svg class="icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
    <symbol id="icon-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></symbol>
    <symbol id="icon-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"></path></symbol>
    <symbol id="icon-theme" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path></symbol>
    <symbol id="icon-source" viewBox="0 0 24 24"><path d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18"></path></symbol>
    <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"></path></symbol>
    <symbol id="icon-edit" viewBox="0 0 24 24"><path d="m15 4 5 5M4 20l5-1L20 8a3.5 3.5 0 0 0-5-5L4 14z"></path></symbol>
    <symbol id="icon-chevron" viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"></path></symbol>
    <symbol id="icon-up" viewBox="0 0 24 24"><path d="M12 20V4m-6 6 6-6 6 6"></path></symbol>
  </defs></svg>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="topbar" data-pagefind-ignore>
    <div class="topbar-inner">
      <div class="brand-area">
        <button class="icon-button nav-toggle" type="button" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">{{ icon('menu') }}</button>
        <a class="brand" href="/" aria-label="lazylab documentation home"><img class="logo" src="/assets/brand/lazylab-mark.svg" alt="" width="30" height="30"><span>lazylab</span><span class="brand-label">docs</span></a>
      </div>
      <button class="search-trigger" type="button" aria-label="Search documentation" aria-haspopup="dialog" data-search-trigger>{{ icon('search') }}<span>Search documentation<span class="search-dots">…</span></span><kbd data-search-shortcut>Ctrl K</kbd></button>
      <nav class="top-links" aria-label="Project links">
        <a class="source-link" href="{{ site.repo }}">{{ icon('source') }}<span>Source</span></a>
        <span class="top-divider" aria-hidden="true"></span>
        <button class="icon-button theme-toggle" type="button" aria-label="Switch colour theme">{{ icon('theme') }}</button>
      </nav>
    </div>
    <div class="reading-progress" aria-hidden="true"></div>
  </header>
  <div class="shell">
    <aside class="sidebar" id="sidebar" aria-label="Documentation navigation" data-pagefind-ignore>
      <div class="sidebar-intro"><span class="sidebar-title">Documentation</span><span class="version-badge">v0.1</span></div>
      <nav aria-label="Documentation pages">
      {% for section in nav %}
        <p class="nav-section">{{ section.title }}</p>
        <ul>{% for item in section.items %}
          <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {% endfor %}</ul>
      {% endfor %}
      </nav>
      <a class="sidebar-note" href="/testing/"><span class="status-dot" aria-hidden="true"></span><span>Pre-1.0 · Open for testing</span>{{ icon('arrow') }}</a>
    </aside>
    <button class="nav-backdrop" type="button" aria-label="Close navigation" hidden></button>
    <main class="content" id="main-content" tabindex="-1">
      <div class="article-meta" data-pagefind-ignore>
        <div class="breadcrumbs"><a href="/">Docs</a><span aria-hidden="true">/</span><span>{{ nav | sectionFor(page.url) }}</span></div>
        <a class="edit-link" href="{{ site.editBase }}{{ page.inputPath | sourcePath }}">{{ icon('edit') }}<span>Edit this page</span></a>
      </div>
      {% block article %}
      <article data-pagefind-body>
        <div class="article-heading"><span class="page-eyebrow">{{ nav | sectionFor(page.url) }}</span><h1 data-pagefind-meta="title">{{ title }}</h1>
        {% if abstract %}<p class="abstract">{{ abstract }}</p>{% endif %}
        <div class="article-byline" data-pagefind-ignore><span class="byline-dot" aria-hidden="true"></span><span>lazylab documentation</span><span class="byline-separator" aria-hidden="true">·</span><span data-reading-time></span></div></div>
        {{ content | safe }}
      </article>
      {% endblock %}
      {% set pg = nav | pager(page.url) %}
      <nav class="pager" aria-label="Previous and next pages" data-pagefind-ignore>
        {% if pg.prev %}<a class="prev" href="{{ pg.prev.url }}"><span class="pager-label">Previous</span><span>{{ pg.prev.title }}</span></a>{% else %}<span></span>{% endif %}
        {% if pg.next %}<a class="next" href="{{ pg.next.url }}"><span class="pager-label">Up next</span><span>{{ pg.next.title }} {{ icon('arrow') }}</span></a>{% endif %}
      </nav>
      <footer class="page-footer" data-pagefind-ignore><a href="{{ site.editBase }}{{ page.inputPath | sourcePath }}">{{ icon('edit') }}Edit this page</a><span>lazylab · <a href="{{ site.repo }}/-/blob/main/LICENSE">MIT</a> · <a href="{{ site.repo }}/-/issues">Report an issue</a></span></footer>
    </main>
    <aside class="page-outline" data-pagefind-ignore>
      <details class="outline" open>
        <summary>On this page {{ icon('chevron') }}</summary>
        <nav id="page-toc" aria-label="On this page"></nav>
        <div class="outline-tools"><a href="{{ site.editBase }}{{ page.inputPath | sourcePath }}">{{ icon('edit') }}Suggest a change</a><a href="#top">{{ icon('up') }}Back to top</a></div>
      </details>
    </aside>
  </div>
  <div class="toast" role="status" aria-live="polite" hidden></div>
  <noscript><p class="noscript-note">Search, copy buttons and scroll tracking require JavaScript. Page links and the table of contents work without it.</p></noscript>
</body>
</html>
