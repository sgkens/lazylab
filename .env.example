# lazylab environment. Copy to .env; Bun loads .env automatically on metal,
# and compose.yaml passes it into the container.

# ---- Network ---------------------------------------------------------------
# Metal: listen address. 127.0.0.1 = this machine only; 0.0.0.0 = LAN.
HOST=127.0.0.1
PORT=3000

# Docker: host-side bind address and port used by compose.yaml.
LAZYLAB_BIND=127.0.0.1
LAZYLAB_PORT=3000

# ---- HTTPS -----------------------------------------------------------------
# Option A, built-in TLS. "on" uses LAZYLAB_TLS_CERT/KEY if set, otherwise
# generates a self-signed cert into <data dir>/tls on first start.
LAZYLAB_TLS=off
# LAZYLAB_TLS_CERT=/path/to/cert.pem
# LAZYLAB_TLS_KEY=/path/to/key.pem
# Extra names/IPs for the self-signed cert, comma-separated (e.g. the desktop's LAN IP).
# LAZYLAB_TLS_SANS=192.168.1.50,desktop.lan

# Option B, HTTPS reverse proxy (Tailscale Serve, Caddy). Tells lazylab to trust
# X-Forwarded-* from the proxy so cookies get the Secure flag.
# Values: loopback | true | <hop count> | <CIDR list>
# LAZYLAB_TRUST_PROXY=loopback
# Hostnames the UI is reached through, if the proxy rewrites the Host header
# (symptom: every save fails with "Cross-origin request rejected").
# LAZYLAB_PUBLIC_HOSTS=desktop.tailnet-name.ts.net

# ---- Storage ---------------------------------------------------------------
# Vault, cache and TLS files. Defaults to ./.data on metal, /data in Docker.
# LAZYLAB_DATA_DIR=./.data

# ---- Shared findings (optional) ---------------------------------------------
# Independent BugKB service. Unset disables automatic briefing searches and KB tools.
# On metal, the default BugKB address is http://127.0.0.1:8090.
# Inside Docker, use an address reachable from the lazylab container; loopback is the container itself.
# LAZYLAB_BUGKB_URL=http://127.0.0.1:8090

# ---- One-time import -------------------------------------------------------
# If set during first-run setup, this token is imported into the vault as the
# active profile. Remove it afterwards; it is not read again.
# GITLAB_HOST=https://gitlab.com
# GITLAB_TOKEN=
