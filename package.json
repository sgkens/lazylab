{
  "name": "lazylab",
  "private": true,
  "version": "0.1.0",
  "description": "A self-hosted GitLab workspace with an inbox, push notifications, CI failure triage, a command-line client and an MCP server for coding agents.",
  "license": "MIT",
  "author": "sgkens",
  "homepage": "https://gitlab.com/sgkens/lazylab",
  "repository": { "type": "git", "url": "https://gitlab.com/sgkens/lazylab.git" },
  "bugs": "https://gitlab.com/sgkens/lazylab/-/issues",
  "keywords": ["gitlab", "self-hosted", "ci", "mcp", "developer-tools", "cli"],
  "type": "module",
  "bin": {
    "lazy": "cli/lazy.ts"
  },
  "scripts": {
    "dev": "bun --watch server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production bun server.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "docker:build": "docker build -t lazylab:local .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "lazy": "bun cli/lazy.ts",
    "cli:build": "bun build cli/lazy.ts --compile --minify --outfile dist-cli/lazy"
  },
  "dependencies": {
    "express": "^4.21.2",
    "node-forge": "~1.3.3",
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.3.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
